#!/usr/bin/env bash
# Fake curl for scripts/ship/test-ship.sh: answers the two Vercel GETs, the
# pinned static ffmpeg download (scripts/ship/install-ffmpeg.sh), the
# OpenRouter speech endpoint, and the GitHub release-asset upload. Fails
# (exit 22, like curl -f on 401) unless the bearer token, or the upload token,
# arrives on stdin (-K -). Logs argv (never stdin) to $FAKE_LOG, because the
# config carries the key and a case asserts no token is ever logged; a case
# that needs the config asks for it with $FAKE_CURL_CONFIG (every config is
# appended; the last one is also $FAKE_CURL_CONFIG.last).
set -euo pipefail
echo "curl $*" >>"$FAKE_LOG"
config="$(cat)"
# The static ffmpeg build scripts/ship/install-ffmpeg.sh pins: a public release
# asset, so no token. It writes the file the URL names from $FAKE_FFMPEG_DIR to
# the -o path, or fails as curl --fail does when $FAKE_CURL_FAIL is set.
case "$*" in
  *github.com/eugeneware/ffmpeg-static/releases/download/*)
    [ "${FAKE_CURL_FAIL:-0}" = 0 ] || exit 22
    out_path='' prev=''
    for arg; do
      [ "$prev" != -o ] || out_path="$arg"
      prev="$arg"
    done
    cp "${FAKE_FFMPEG_DIR:?}/${arg##*/}" "${out_path:?}"
    exit 0
    ;;
esac
if [ -n "${FAKE_CURL_CONFIG:-}" ]; then
  printf '%s\n' "$config" >>"$FAKE_CURL_CONFIG"
  printf '%s\n' "$config" >"$FAKE_CURL_CONFIG.last"
fi
case "$config" in
  *"Authorization: Bearer ${VERCEL_TOKEN:-unset}"*) ;;
  *"Authorization: Bearer ${OPENROUTER_API_KEY:-unset-openrouter}"*) ;;
  # The release-asset upload takes a bearer token
  # (scripts/ship/pr-video-upload.sh).
  *"Authorization: Bearer ${FAKE_UPLOAD_TOKEN:-__no_upload_token__}"*) ;;
  *"x-api-key: ${ANTHROPIC_API_KEY:-unset-anthropic}"*) ;;
  *) exit 22 ;;
esac
[ "${FAKE_CURL_FAIL:-0}" = 0 ] || exit 22
# The URL and the output path come from the config on stdin when there is one
# (pr-video-narrate.sh), else from argv (the Vercel GETs).
config_url="$(sed -n 's/^url = "\(.*\)"$/\1/p' <<<"$config")"
config_out="$(sed -n 's/^output = "\(.*\)"$/\1/p' <<<"$config")"
for url; do :; done
[ -z "$config_url" ] || url="$config_url"
case "$url" in
  */v6/deployments\?*) cat "$FAKE_VERCEL_DEPLOYMENTS" ;;
  */v9/projects/*) cat "$FAKE_VERCEL_PROJECT" ;;
  */audio/speech)
    # The speech endpoint: $FAKE_TTS_BODY to the output path, $FAKE_TTS_STATUS written out.
    [ -z "$config_out" ] || cp "${FAKE_TTS_BODY:-/dev/null}" "$config_out"
    printf '%s' "${FAKE_TTS_STATUS:-200}"
    ;;
  *api.anthropic.com/v1/messages*)
    # The narration script's one call: $FAKE_ANTHROPIC_BODY out, $FAKE_ANTHROPIC_STATUS written out.
    # The default answer is a finished one, long enough to pass the word floor.
    # The reviewer's call sends no thinking field, and nor may this one: a
    # request that carries one is answered as the API answers a bad request.
    case "$config" in
      *'\"thinking\"'*)
        [ -z "$config_out" ] || printf '%s' '{"type":"error","error":{"type":"invalid_request_error","message":"thinking: the fake refuses a thinking field"}}' >"$config_out"
        printf '400'
        exit 0
        ;;
    esac
    default_reply='{"stop_reason":"end_turn","content":[{"type":"text","text":"This pull request changes how the course is drawn. The recording opens a hole, rolls the die and takes a shot, so the reviewer can see the new look on the board from the first tee to the green."}],"usage":{"input_tokens":300,"output_tokens":50}}'
    [ -z "$config_out" ] || printf '%s' "${FAKE_ANTHROPIC_BODY:-$default_reply}" >"$config_out"
    printf '%s' "${FAKE_ANTHROPIC_STATUS:-200}"
    ;;
  *uploads.github.com/repos/*/releases/*/assets*)
    # With FAKE_GH_RELEASES_DIR set, the upload lands in the stateful store
    # (gh-releases): the status and body GitHub gives, the asset kept.
    if [ -n "${FAKE_GH_RELEASES_DIR:-}" ]; then
      data_file="$(sed -n 's/^data-binary = "@\(.*\)"$/\1/p' <<<"$config")"
      bash "$(dirname "$0")/gh-releases" upload "$url" "$data_file" "${config_out:-/dev/null}"
      exit 0
    fi
    # The documented release-asset upload, answering the fields GitHub answers:
    # the asset's own id and name, and the browser_download_url the caller
    # reads (POST /repos/{owner}/{repo}/releases/{id}/assets). The name comes
    # from the query string, as it does for real.
    asset_name="$(sed -n 's/.*[?&]name=\([^&"]*\).*/\1/p' <<<"$url")"
    default_upload="$(printf '{"id":55500001,"name":"%s","label":null,"state":"uploaded","content_type":"video/mp4","browser_download_url":"https://github.com/%s/releases/download/%s/%s"}' \
      "$asset_name" "${FAKE_UPLOAD_REPO:-derek-hobden/paper-golf}" "${FAKE_UPLOAD_TAG:-pr-videos}" "$asset_name")"
    [ -z "$config_out" ] || printf '%s' "${FAKE_UPLOAD_BODY:-$default_upload}" >"$config_out"
    printf '%s' "${FAKE_UPLOAD_STATUS:-201}"
    ;;
  *) exit 22 ;;
esac
