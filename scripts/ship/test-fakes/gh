#!/usr/bin/env bash
# Fake gh for scripts/ship/test-ship.sh. Logs every call to $FAKE_LOG; never
# touches the network. Driven by FAKE_GH_* env and fixture files.
# FAKE_GH_FAIL_PATH=<substring> refuses just the api calls whose path matches,
# the way gh reports a 404. FAKE_GH_RELEASES_DIR=<dir> answers the releases API
# from a stateful store instead (gh-releases).
set -euo pipefail
echo "gh $*" >>"$FAKE_LOG"
# FAKE_GH_DRAINS_STDIN=1 reads stdin to its end on every api call, as a command
# that reads stdin would: a `while read` loop that hands gh its own input then
# loses every line after the first.
if [ "${FAKE_GH_DRAINS_STDIN:-}" = 1 ] && [ "${1:-}" = api ]; then
  cat >/dev/null || true
fi
if [ "${FAKE_GH_FAIL:-}" = api ] && [ "${1:-}" = api ]; then
  exit 1
fi

# Remember --title and --body-file from an issue write so a test can read them.
save_issue() {
  local prev="" arg
  for arg in "$@"; do
    if [ "$prev" = --title ]; then printf '%s\n' "$arg" >"$FAKE_STATE/issue-title"; fi
    if [ "$prev" = --body-file ] && [ -f "$arg" ]; then cp "$arg" "$FAKE_STATE/issue-body"; fi
    prev="$arg"
  done
}

case "$1" in
  auth) [ "${FAKE_GH_AUTH:-ok}" = ok ] ;;
  config) echo "${FAKE_GH_PROTOCOL:-https}" ;;
  repo)
    case "$2" in
      view)
        if [ -n "${FAKE_GH_VIS:-}" ]; then echo "$FAKE_GH_VIS"; else
          echo "GraphQL: Could not resolve to a Repository" >&2
          exit 1
        fi ;;
      create) touch "$FAKE_STATE/created" ;;
      *) exit 2 ;;
    esac ;;
  label) [ "${2:-}" = create ] || exit 2 ;;
  pr)
    # gh pr merge: only --auto can be refused, the way GitHub refuses the
    # enablePullRequestAutoMerge mutation (FAKE_GH_MERGE_FAIL is its message).
    [ "${2:-}" = merge ] || exit 2
    auto=0
    for arg in "$@"; do
      if [ "$arg" = --auto ]; then auto=1; fi
    done
    if [ "$auto" = 1 ] && [ -n "${FAKE_GH_MERGE_FAIL:-}" ]; then
      printf '%s\n' "$FAKE_GH_MERGE_FAIL" >&2
      exit 1
    fi
    echo "https://example.test/pull/${3:-0}" ;;
  issue)
    case "${2:-}" in
      list) printf '%s\n' "${FAKE_GH_ISSUE_LIST:-[]}" ;;
      create | comment | edit)
        save_issue "$@"
        echo "https://example.test/issues/1"
        ;;
      *) exit 2 ;;
    esac ;;
  api)
    # With FAKE_GH_RELEASES_DIR set, the releases API is the stateful model in
    # gh-releases (GitHub's own status codes, bodies and pagination); every
    # other path, and every call when it is unset, takes the fixtures below.
    if [ -n "${FAKE_GH_RELEASES_DIR:-}" ]; then
      shift
      rc=0
      bash "$(dirname "$0")/gh-releases" api "$@" || rc=$?
      [ "$rc" = 100 ] || exit "$rc"
      set -- api "$@"
    fi
    # gh api <path> --jq <expr>: the Nth jq call reads $FAKE_CI_JSON_<N> if it
    # exists, else $FAKE_CI_JSON (so --from tests can change the answer).
    # --input <file> is a comment write (review-status.sh): the body is saved
    # and the call does not consume a jq fixture. FAKE_GH_WRITE_FAIL refuses
    # those writes the way gh reports a refusal: "<code>" fails every method,
    # "<METHOD>:<code>" only that one.
    # --method with no --jq and no --input is a plain write. POST is a workflow
    # dispatch (FAKE_GH_DISPATCH_FAIL). PUT and PATCH are the branch update.
    shift
    expr=''
    input=''
    method=''
    path=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --jq) expr="$2"; shift ;;
        --input) input="$2"; shift ;;
        --method) method="$2"; shift ;;
        /* | repos/*) path="$1" ;;
      esac
      shift
    done
    # One path refused the way gh reports a 404, so a case can have a lookup
    # miss (the release the explainer hangs on, before it exists) without
    # failing every other call. Like real gh, it skips --jq and prints the
    # error body on stdout, so a caller that keeps stdout on failure sees it.
    case "$path" in
      *"${FAKE_GH_FAIL_PATH:-__no_such_path__}"*)
        echo '{"message":"Not Found","status":"404"}'
        echo "gh: Not Found (HTTP 404)" >&2
        exit 1
        ;;
    esac
    # FAKE_GH_ROUTES=<file>: lines "<path> <fixture>". A read (no --method, or
    # GET) whose path is exactly <path>, query included, answers from that
    # fixture — through --jq when given, as is without — and never touches the
    # call counter below, so a case does not depend on the order of its reads.
    # A fixture of "-" fails the way gh reports a 404, and so does a read no
    # route names (logged as "unrouted <path>").
    if [ -n "${FAKE_GH_ROUTES:-}" ] && [ -z "$input" ] && { [ -z "$method" ] || [ "$method" = GET ]; }; then
      while read -r rpath rfile; do
        [ "$rpath" = "$path" ] || continue
        if [ "$rfile" = - ]; then
          echo "gh: Not Found (HTTP 404)" >&2
          exit 1
        fi
        if [ -n "$expr" ]; then jq -r "$expr" "$rfile"; else cat "$rfile"; fi
        exit 0
      done <"$FAKE_GH_ROUTES"
      echo "unrouted $path" >>"$FAKE_LOG"
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    fi
    if [ -n "$input" ]; then
      refuse="${FAKE_GH_WRITE_FAIL:-}"
      case "$refuse" in
        *:*)
          if [ "${refuse%%:*}" = "$method" ]; then refuse="${refuse##*:}"; else refuse=''; fi
          ;;
      esac
      if [ -n "$refuse" ]; then
        echo "comment-write-refused" >>"$FAKE_LOG"
        case "$refuse" in
          404) echo "gh: Not Found (HTTP 404)" >&2 ;;
          *) echo "gh: Resource not accessible by integration (HTTP $refuse)" >&2 ;;
        esac
        exit 1
      fi
      cp "$input" "$FAKE_STATE/comment-body"
      echo "comment-write" >>"$FAKE_LOG"
      exit 0
    fi
    # POST is a workflow dispatch. PUT and PATCH are the branch update and the
    # repo settings. A dispatch refusal must not fail those other methods.
    case "$method" in
      POST)
        if [ -n "${FAKE_GH_DISPATCH_FAIL:-}" ]; then
          printf '%s\n' "$FAKE_GH_DISPATCH_FAIL" >&2
          exit 1
        fi
        # A POST that asks for a field is a create whose answer the caller reads
        # (the release pr-video-upload.sh makes); it falls through to the jq
        # fixtures below. A POST with no --jq is a dispatch, which answers
        # nothing.
        [ -n "$expr" ] || exit 0
        ;;
      PUT)
        if [ -n "${FAKE_GH_PUT_BODY:-}" ]; then printf '%s\n' "$FAKE_GH_PUT_BODY"; fi
        if [ -n "${FAKE_GH_PUT_STDERR:-}" ]; then printf '%s\n' "$FAKE_GH_PUT_STDERR" >&2; fi
        exit "${FAKE_GH_PUT_EXIT:-0}"
        ;;
      PATCH)
        if [ -n "${FAKE_GH_PATCH_STDERR:-}" ]; then printf '%s\n' "$FAKE_GH_PATCH_STDERR" >&2; fi
        exit "${FAKE_GH_PATCH_EXIT:-0}"
        ;;
      DELETE)
        exit "${FAKE_GH_DELETE_EXIT:-0}"
        ;;
    esac
    if [ -n "$method" ] && [ -z "$expr" ]; then
      exit 0
    fi
    [ -n "$expr" ] || exit 0
    n="$(cat "$FAKE_STATE/api-calls" 2>/dev/null || echo 0)"
    n=$((n + 1))
    echo "$n" >"$FAKE_STATE/api-calls"
    file="${FAKE_CI_JSON}"
    [ -f "${FAKE_CI_JSON}.$n" ] && file="${FAKE_CI_JSON}.$n"
    jq -r "$expr" "$file" ;;
  *) exit 2 ;;
esac
