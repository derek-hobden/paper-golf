#!/usr/bin/env bash
# Fake gh for scripts/ship/test-ship.sh. Logs every call to $FAKE_LOG; never
# touches the network. Driven by FAKE_GH_* env and fixture files.
set -euo pipefail
echo "gh $*" >>"$FAKE_LOG"
if [ "${FAKE_GH_FAIL:-}" = api ] && [ "${1:-}" = api ]; then
  exit 1
fi

# Remember --title and --body-file from an issue write so a test can read them.
save_issue() {
  local prev="" arg
  for arg in "$@"; do
    if [ "$prev" = --title ]; then printf '%s\n' "$arg" >"$FAKE_STATE/issue-title"; fi
    if [ "$prev" = --body-file ] && [ -f "$arg" ]; then cp "$arg" "$FAKE_STATE/issue-body"; fi
    prev="$arg"
  done
}

case "$1" in
  auth) [ "${FAKE_GH_AUTH:-ok}" = ok ] ;;
  config) echo "${FAKE_GH_PROTOCOL:-https}" ;;
  repo)
    case "$2" in
      view)
        if [ -n "${FAKE_GH_VIS:-}" ]; then echo "$FAKE_GH_VIS"; else
          echo "GraphQL: Could not resolve to a Repository" >&2
          exit 1
        fi ;;
      create) touch "$FAKE_STATE/created" ;;
      *) exit 2 ;;
    esac ;;
  label) [ "${2:-}" = create ] || exit 2 ;;
  pr)
    # gh pr merge: only --auto can be refused, the way GitHub refuses the
    # enablePullRequestAutoMerge mutation (FAKE_GH_MERGE_FAIL is its message).
    [ "${2:-}" = merge ] || exit 2
    auto=0
    for arg in "$@"; do
      if [ "$arg" = --auto ]; then auto=1; fi
    done
    if [ "$auto" = 1 ] && [ -n "${FAKE_GH_MERGE_FAIL:-}" ]; then
      printf '%s\n' "$FAKE_GH_MERGE_FAIL" >&2
      exit 1
    fi
    echo "https://example.test/pull/${3:-0}" ;;
  issue)
    case "${2:-}" in
      list) printf '%s\n' "${FAKE_GH_ISSUE_LIST:-[]}" ;;
      create | comment | edit)
        save_issue "$@"
        echo "https://example.test/issues/1"
        ;;
      *) exit 2 ;;
    esac ;;
  api)
    # gh api <path> --jq <expr>: the Nth jq call reads $FAKE_CI_JSON_<N> if it
    # exists, else $FAKE_CI_JSON (so --from tests can change the answer).
    # --input <file> is a comment write (review-status.sh): the body is saved
    # and the call does not consume a jq fixture. FAKE_GH_WRITE_FAIL refuses
    # those writes the way gh reports a refusal: "<code>" fails every method,
    # "<METHOD>:<code>" only that one.
    # --method with no --jq and no --input is a plain write. POST is a workflow
    # dispatch (FAKE_GH_DISPATCH_FAIL). PUT and PATCH are the branch update.
    shift
    expr=''
    input=''
    method=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --jq) expr="$2"; shift ;;
        --input) input="$2"; shift ;;
        --method) method="$2"; shift ;;
      esac
      shift
    done
    if [ -n "$input" ]; then
      refuse="${FAKE_GH_WRITE_FAIL:-}"
      case "$refuse" in
        *:*)
          if [ "${refuse%%:*}" = "$method" ]; then refuse="${refuse##*:}"; else refuse=''; fi
          ;;
      esac
      if [ -n "$refuse" ]; then
        echo "comment-write-refused" >>"$FAKE_LOG"
        case "$refuse" in
          404) echo "gh: Not Found (HTTP 404)" >&2 ;;
          *) echo "gh: Resource not accessible by integration (HTTP $refuse)" >&2 ;;
        esac
        exit 1
      fi
      cp "$input" "$FAKE_STATE/comment-body"
      echo "comment-write" >>"$FAKE_LOG"
      exit 0
    fi
    # POST is a workflow dispatch. PUT and PATCH are the branch update and the
    # repo settings. A dispatch refusal must not fail those other methods.
    case "$method" in
      POST)
        if [ -n "${FAKE_GH_DISPATCH_FAIL:-}" ]; then
          printf '%s\n' "$FAKE_GH_DISPATCH_FAIL" >&2
          exit 1
        fi
        exit 0
        ;;
      PUT)
        if [ -n "${FAKE_GH_PUT_BODY:-}" ]; then printf '%s\n' "$FAKE_GH_PUT_BODY"; fi
        if [ -n "${FAKE_GH_PUT_STDERR:-}" ]; then printf '%s\n' "$FAKE_GH_PUT_STDERR" >&2; fi
        exit "${FAKE_GH_PUT_EXIT:-0}"
        ;;
      PATCH)
        if [ -n "${FAKE_GH_PATCH_STDERR:-}" ]; then printf '%s\n' "$FAKE_GH_PATCH_STDERR" >&2; fi
        exit "${FAKE_GH_PATCH_EXIT:-0}"
        ;;
      DELETE)
        exit "${FAKE_GH_DELETE_EXIT:-0}"
        ;;
    esac
    if [ -n "$method" ] && [ -z "$expr" ]; then
      exit 0
    fi
    [ -n "$expr" ] || exit 0
    n="$(cat "$FAKE_STATE/api-calls" 2>/dev/null || echo 0)"
    n=$((n + 1))
    echo "$n" >"$FAKE_STATE/api-calls"
    file="${FAKE_CI_JSON}"
    [ -f "${FAKE_CI_JSON}.$n" ] && file="${FAKE_CI_JSON}.$n"
    jq -r "$expr" "$file" ;;
  *) exit 2 ;;
esac
