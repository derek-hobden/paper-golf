{
  "name": "paper-golf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4 --testTimeout=30000",
    "test:ship": "bash scripts/ship/test-ship.sh",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "presmoke": "npm run build",
    "smoke": "playwright test",
    "smoke:quick": "playwright test --project=chrome --grep @quick",
    "verify": "bash scripts/verify.sh",
    "shots": "SHOTS=1 playwright test -g screenshots",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --max-warnings 0 --fix"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
