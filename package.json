{
  "name": "paper-golf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --max-warnings 0 --fix"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
