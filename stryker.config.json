{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vite.config.ts",
    "related": true
  },
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 60000,
  "timeoutFactor": 1.5,
  "dryRunTimeoutMinutes": 10,
  "reporters": ["clear-text", "json"],
  "thresholds": {
    "high": 100,
    "low": 0,
    "break": null
  },
  "mutate": ["src/engine/**/*.ts", "src/game/**/*.ts", "!**/*.test.ts"],
  "ignorePatterns": ["dist", "coverage", "test-results", "node_modules", "reports", ".stryker-tmp"]
}
